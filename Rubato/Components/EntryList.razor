@code {
    [Parameter] public List<EntryModel> Entries { get; set; } = [];

    [Parameter] public List<ProjectModel> Projects { get; set; } = [];

    [Parameter] public EventCallback OnEntryChanged { get; set; }

    [Parameter] public EventCallback OnAddEntry { get; set; }

    [Parameter] public bool CanCopy { get; set; }

    [Parameter] public EventCallback OnCopy { get; set; }

    private double TotalHours => Entries.Sum(e => e.Duration ?? 0);

    private bool HasInvalidTimes => Entries.Any(e => e.HasInvalidTime);

    private IEnumerable<EntryModel> OrderedEntries =>
        Entries.OrderBy(e => e.SortOrder.GetValueOrDefault(int.MaxValue)).ThenBy(e => e.Time);
}

<div class="vstack gap-2">
    <div class="row g-2 align-items-end border-bottom pb-2">
        <div class="col-1">
            Time
        </div>
        <div class="col-1">
            Hours
        </div>
        <div class="col-2">
            Project

            <a href="/projects" class="ms-1 small">
                Manage
            </a>
        </div>
        <div class="col-1">
            Task ID
        </div>
        <div class="col">
            Description
        </div>
        <div class="col-1">
            Sort
        </div>
        <div class="col-auto">
            <button type="button"
                    class="btn btn-sm btn-outline-secondary"
                    @onclick="OnCopy"
                    disabled="@(!CanCopy)">
                <i class="bi bi-copy"></i>
            </button>
        </div>
    </div>

    @foreach (var entry in OrderedEntries)
    {
        <EntryRow @key="entry.Id" Entry="entry" Projects="Projects" OnEntryChanged="OnEntryChanged" />
    }

    @if (Entries.Count == 0)
    {
        <div class="text-center text-muted small py-3">
            No entries for this day.
        </div>
    }

    <div class="row">
        @if (Entries.Count > 0)
        {
            <div class="col-2 text-end">
                Total:
                <strong class="@(TotalHours >= 8 ? "text-success" : "")">
                    @TotalHours.ToString("N2")
                </strong>
            </div>

            @if (HasInvalidTimes)
            {
                <div class="col text-danger small">
                    <i class="bi bi-exclamation-triangle"></i>
                    Some times could not be read and are not counted.
                </div>
            }
        }

        <div class="col text-end">
            <button type="button" class="btn btn-primary btn-sm" @onclick="OnAddEntry">
                Add Entry
            </button>
        </div>
    </div>
</div>
