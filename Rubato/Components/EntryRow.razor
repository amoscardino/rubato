@inherits CancellableComponentBase

<tr>
    <td>
        <textarea @bind="Entry.Time"
                  @bind:after="SaveEntryAsync"
                  class="form-control form-control-sm @(Entry.HasInvalidTime ? "border-danger" : "")"
                  title="@InvalidTimeMessage"
                  rows="@TimeRows"></textarea>
    </td>

    <td>
        <input type="text"
               value="@Entry.Duration?.ToString("N2")"
               class="form-control form-control-sm text-end"
               disabled />
    </td>

    <td>
        <select @bind="Entry.ProjectId"
                @bind:after="SaveEntryAsync"
                class="form-select form-select-sm"
                style="@ProjectSelectStyle">
            <option value=""></option>
            @foreach (var project in Projects)
            {
                <option value="@project.Id">@project.Name</option>
            }
        </select>
    </td>

    <td>
        <input @bind="Entry.TaskId"
               @bind:after="SaveEntryAsync"
               type="text"
               class="form-control form-control-sm" />
    </td>

    <td>
        <div class="input-group input-group-sm">
            <input @bind="Entry.Description"
                   @bind:after="SaveEntryAsync"
                   type="text"
                   class="form-control form-control-sm" />
            <CopyButton Text="@Entry.ClipboardText" />
        </div>

        @if (Error is not null)
        {
            <div class="alert alert-danger small mt-1 mb-0 p-1">
                <i class="bi bi-exclamation-triangle-fill"></i>
                @Error
            </div>
        }
    </td>

    <td>
        <div class="input-group input-group-sm">
            <input @bind="Entry.SortOrder"
                   @bind:after="SaveEntryAsync"
                   type="text"
                   inputmode="numeric"
                   pattern="[0-9]*"
                   class="form-control form-control-sm" />
            <button type="button"
                    class="btn btn-sm btn-outline-danger"
                    @onclick="DeleteEntryAsync"
                    disabled="@IsBusy">
                <i class="bi bi-trash"></i>
            </button>
        </div>
    </td>
</tr>
