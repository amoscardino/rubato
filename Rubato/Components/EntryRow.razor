@inherits CancellableComponentBase
@inject EntryService EntryService
@inject IJSRuntime JS
@code {
    [Parameter] public EntryModel Entry { get; set; } = new();

    [Parameter] public List<ProjectModel> Projects { get; set; } = new();

    [Parameter] public EventCallback OnEntryChanged { get; set; }

    private static readonly TimeSpan CopiedFeedbackDuration = TimeSpan.FromSeconds(2);

    private bool IsSaving { get; set; } = false;

    private bool JustCopied { get; set; } = false;

    private string? SaveError { get; set; }

    private int _copyCount = 0;

    private string ProjectSelectStyle => Entry.ProjectId.HasValue
        ? $"--bs-border-color: {Projects.FirstOrDefault(p => p.Id == Entry.ProjectId)?.Color}"
        : string.Empty;

    private static string? InvalidTimeMessage(IReadOnlyList<string> invalidLines)
        => invalidLines.Count == 0
            ? null
            : $"Not a time range, so it adds no hours: {string.Join(", ", invalidLines)}";

    private async Task SaveEntryAsync()
    {
        IsSaving = true;
        SaveError = null;
        StateHasChanged();

        try
        {
            await EntryService.UpdateEntryAsync(Entry, CancellationToken);
        }
        catch (OperationCanceledException)
        {
            // The component is going away, so there is nothing left to render or notify. Returning
            // before StateHasChanged also keeps us from rendering a component being disposed.
            return;
        }
        catch (Exception ex)
        {
            // An exception escaping an event handler takes the whole circuit down with it, so the
            // row reports the failure itself and stays usable.
            SaveError = ex.Message;
        }
        finally
        {
            IsSaving = false;
        }

        StateHasChanged();

        // Notify the parent component that the entry has changed
        if (SaveError is null && OnEntryChanged.HasDelegate)
        {
            await OnEntryChanged.InvokeAsync();
        }
    }

    private async Task CopyToClipboardAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("copyToClipboard", CancellationToken, Entry.ClipboardText);
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (JSException)
        {
            SaveError = "Could not copy to the clipboard.";
            StateHasChanged();
            return;
        }

        var copy = ++_copyCount;
        JustCopied = true;
        StateHasChanged();

        try
        {
            await Task.Delay(CopiedFeedbackDuration, CancellationToken);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        // A later copy is now responsible for clearing the checkmark
        if (copy != _copyCount)
        {
            return;
        }

        JustCopied = false;
        StateHasChanged();
    }

    private async Task DeleteEntryAsync()
    {
        IsSaving = true;
        SaveError = null;
        StateHasChanged();

        try
        {
            await EntryService.DeleteEntryAsync(Entry.Id, CancellationToken);
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (Exception ex)
        {
            SaveError = ex.Message;
        }
        finally
        {
            IsSaving = false;
        }

        StateHasChanged();

        // Notify the parent component that the entry has been deleted
        if (SaveError is null && OnEntryChanged.HasDelegate)
        {
            await OnEntryChanged.InvokeAsync();
        }
    }
}

@{
    var invalidTimeLines = Entry.InvalidTimeLines;
}

<div class="row g-2">
    <div class="col-1">
        <textarea @bind="Entry.Time"
                  @bind:after="SaveEntryAsync"
                  class="form-control form-control-sm @(invalidTimeLines.Count > 0 ? "border-danger" : "")"
                  title="@InvalidTimeMessage(invalidTimeLines)"
                  rows="@Entry.TimeRows"></textarea>
    </div>
    <div class="col-1">
        <input type="text"
               value="@Entry.Duration?.ToString("N2")"
               class="form-control form-control-sm text-end"
               disabled />
    </div>
    <div class="col-2">
        <select @bind="Entry.ProjectId"
                @bind:after="SaveEntryAsync"
                class="form-select form-select-sm"
                style="@ProjectSelectStyle">
            <option value=""></option>
            @foreach (var project in Projects)
            {
                <option value="@project.Id">@project.Name</option>
            }
        </select>
    </div>
    <div class="col-1">
        <input @bind="Entry.TaskId"
               @bind:after="SaveEntryAsync"
               type="text"
               class="form-control form-control-sm" />
    </div>
    <div class="col">
        <div class="input-group input-group-sm">
            <input @bind="Entry.Description"
                   @bind:after="SaveEntryAsync"
                   type="text"
                   class="form-control form-control-sm" />
            <button type="button"
                    class="btn @(JustCopied ? "btn-outline-success" : "btn-outline-secondary")"
                    title="@(JustCopied ? "Copied" : "Copy to clipboard")"
                    @onclick="CopyToClipboardAsync"
                    disabled="@(string.IsNullOrWhiteSpace(Entry.ClipboardText))">
                <i class="bi @(JustCopied ? "bi-clipboard-check" : "bi-clipboard")"></i>
            </button>
        </div>
    </div>
    <div class="col-1">
        <input @bind="Entry.SortOrder"
               @bind:after="SaveEntryAsync"
               type="text"
               inputmode="numeric"
               pattern="[0-9]*"
               class="form-control form-control-sm" />
    </div>
    @if (SaveError is not null)
    {
        <div class="col-auto d-flex align-items-center text-danger"
             title="@($"Not saved: {SaveError}")">
            <i class="bi bi-exclamation-triangle-fill"></i>
        </div>
    }

    <div class="col-auto">
        <button type="button"
                class="btn btn-sm btn-outline-danger"
                @onclick="DeleteEntryAsync"
                disabled="@IsSaving">
            <i class="bi bi-trash"></i>
        </button>
    </div>
</div>