@inherits CancellableComponentBase
@inject ProjectService ProjectService
@code {
    [Parameter] public ProjectModel Project { get; set; } = new();

    private bool IsSaving { get; set; } = false;

    private string? SaveError { get; set; }

    private async Task SaveProjectAsync()
    {
        IsSaving = true;
        SaveError = null;
        StateHasChanged();

        try
        {
            await ProjectService.UpdateProjectAsync(Project, CancellationToken);
        }
        catch (OperationCanceledException)
        {
            // The component is going away, so there is nothing left to render.
            return;
        }
        catch (Exception ex)
        {
            // An exception escaping an event handler would take the whole circuit down.
            SaveError = ex.Message;
        }
        finally
        {
            IsSaving = false;
        }

        StateHasChanged();
    }
}

<div class="row g-2 align-items-center">
    <div class="col">
        <input @bind="Project.Name"
               @bind:after="SaveProjectAsync"
               type="text"
               class="form-control form-control-sm" />
    </div>

    <div class="col-auto">
        <input @bind="Project.Color"
               @bind:after="SaveProjectAsync"
               type="color"
               class="form-control form-control-color form-control-sm"
               title="Project color" />
    </div>

    @if (SaveError is not null)
    {
        <div class="col-auto text-danger" title="@($"Not saved: {SaveError}")">
            <i class="bi bi-exclamation-triangle-fill"></i>
        </div>
    }
</div>
