@inherits CancellableComponentBase

<tr>
    <td>
        <input @bind="Project.Name"
               @bind:after="SaveProjectAsync"
               type="text"
               class="form-control form-control-sm" />

        @if (Error is not null)
        {
            <div class="alert alert-danger small mt-1 mb-0 p-1">
                <i class="bi bi-exclamation-triangle-fill"></i>
                @Error
            </div>
        }
    </td>

    <td>
        <input @bind="Project.WorkItemId"
               @bind:after="SaveProjectAsync"
               type="text"
               class="form-control form-control-sm" />
    </td>

    <td>
        <input @bind="Project.Color"
               @bind:after="SaveProjectAsync"
               type="text"
               class="form-control form-control-sm"
               title="Project color" />
    </td>
</tr>
