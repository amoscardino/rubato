@page "/"
@page "/day"
@page "/day/{dateparam:datetime?}"
@inherits CancellableComponentBase

<PageShell Title="@(Date.ToString("yyyy-MM-dd"))" IsLoading="IsLoading" Error="@Error">
    <Header>
        <div class="row align-items-start">
            <div class="col">
                <h1 class="fs-3 mb-0">
                    @(Date.ToString("ddd, MMM d, yyyy"))
                </h1>
            </div>

            <div class="col-auto text-end">
                <NavButtons Date="Date" />
            </div>
        </div>
    </Header>

    <ChildContent>
        <div class="vstack gap-2">
            @* These column widths have to match the ones EntryRow gives its fields, or the header
               stops lining up with the rows underneath it. *@
            <div class="row g-2 align-items-end border-bottom pb-2">
                <div class="col-1">
                    Time
                </div>
                <div class="col-1">
                    Hours
                </div>
                <div class="col-2">
                    Project

                    <a href="/projects" class="ms-1 small">
                        Manage
                    </a>
                </div>
                <div class="col-1">
                    Task ID
                </div>
                <div class="col">
                    Description
                </div>
                <div class="col-1">
                    Sort
                </div>
                <div class="col-auto">
                    <button type="button"
                            class="btn btn-sm btn-outline-secondary"
                            title="Copy the previous day's entries"
                            @onclick="CopyEntriesAsync"
                            disabled="@(!CanCopy)">
                        <i class="bi bi-copy"></i>
                    </button>
                </div>
            </div>

            <div class="flex-grow-1 vstack gap-2">
                @foreach (var entry in OrderedEntries)
                {
                    <EntryRow @key="entry.Id" Entry="entry" Projects="Projects" OnEntryChanged="ReloadDayAsync" />
                }

                @if (Entries.Count == 0)
                {
                    <div class="text-center text-muted small py-3">
                        No entries for this day.
                    </div>
                }
            </div>

            <div class="row align-items-end">
                @if (Entries.Count > 0)
                {
                    <div class="col-2">
                        Total:
                        <strong class="@(TotalHours >= 8 ? "text-success" : "")">
                            @TotalHours.ToString("N2")
                        </strong>

                        <br />

                        Week:
                        <strong class="@(WeekTotalHours >= 40 ? "text-success" : "")">
                            @WeekTotalHours.ToString("N2")
                        </strong>
                    </div>

                    @if (HasInvalidTimes)
                    {
                        <small class="col text-danger">
                            <i class="bi bi-exclamation-triangle"></i>
                            Some times could not be read and are not counted.
                        </small>
                    }
                }

                <div class="col text-end">
                    <button type="button" class="btn btn-primary btn-sm" @onclick="AddEntryAsync">
                        Add Entry
                    </button>
                </div>
            </div>
        </div>
    </ChildContent>
</PageShell>
