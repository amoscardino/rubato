@page "/"
@page "/day"
@page "/day/{dateparam:datetime?}"
@inherits CancellableComponentBase

<PageShell Title="@(Date.ToString("yyyy-MM-dd"))" IsLoading="IsLoading" Error="@Error">
    <Header>
        <div class="row align-items-start">
            <div class="col">
                <h1 class="h2 mb-0">
                    @(Date.ToString("ddd MMM d"))
                </h1>
            </div>

            <div class="col-auto text-end">
                <NavButtons Date="Date" />
            </div>
        </div>
    </Header>

    <ChildContent>
        <div class="vstack gap-2">
            <div class="flex-grow-1">
                <div class="card shadow overflow-hidden">
                    <div class="card-body p-2">
                        <table class="table table-borderless table-sm mb-0">
                            <colgroup>
                                <col class="col-1" />
                                <col class="col-1" />
                                <col class="col-2" />
                                <col class="col-1" />
                                <col class="col-5" />
                                <col class="col-1" />
                            </colgroup>

                            <thead>
                                <tr>
                                    <th>
                                        Time
                                    </th>
                                    <th>
                                        Hours
                                    </th>
                                    <th>
                                        Project

                                        <a href="/projects" class="ms-1">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                    </th>
                                    <th>
                                        Task ID
                                    </th>
                                    <th>
                                        Description
                                    </th>
                                    <th>
                                        Sort
                                    </th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var entry in OrderedEntries)
                                {
                                    <EntryRow @key="entry.Id"
                                              Entry="entry"
                                              Projects="Projects"
                                              OnEntryChanged="ReloadDayAsync" />
                                }

                                @if (Entries.Count == 0)
                                {
                                    <tr>
                                        <td colspan="6" class="text-center text-muted py-3">
                                            <p>
                                                No entries for this day.
                                            </p>

                                            @if (CanCopy)
                                            {
                                                <button type="button"
                                                        class="btn btn-sm btn-primary"
                                                        @onclick="CopyEntriesAsync">
                                                    <i class="bi bi-copy"></i>
                                                    Copy From Previous Day
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="row align-items-end">
                <div class="col-1">
                    <div class="hstack justify-content-between">
                        <span>
                            Total:
                        </span>
                        <strong class="@(TotalHours >= 8 ? "text-success" : "")">
                            @TotalHours.ToString("N2")
                        </strong>
                    </div>

                    <div class="hstack justify-content-between">
                        <span>
                            Week:
                        </span>
                        <strong class="@(WeekTotalHours >= 40 ? "text-success" : "")">
                            @WeekTotalHours.ToString("N2")
                        </strong>
                    </div>
                </div>

                @if (HasInvalidTimes)
                {
                    <div class="col text-center text-danger">
                        <i class="bi bi-exclamation-triangle"></i>
                        Some times could not be read and are not counted.
                    </div>
                }

                <div class="col text-end">
                    <button type="button" class="btn btn-primary" @onclick="AddEntryAsync">
                        Add Entry
                    </button>
                </div>
            </div>
        </div>
    </ChildContent>
</PageShell>
