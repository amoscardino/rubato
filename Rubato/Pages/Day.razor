@page "/"
@page "/day"
@page "/day/{dateparam:datetime?}"
@inherits CancellableComponentBase

@if (IsLoading)
{
    <PageTitleWithSuffix>Loading...</PageTitleWithSuffix>

    <Loader />
}
else
{
    <PageTitleWithSuffix>@(Date.ToString("yyyy-MM-dd"))</PageTitleWithSuffix>

    <div class="vstack gap-3">
        <div class="row align-items-end">
            <div class="col">
                <h1 class="display-6">
                    @(Date.ToString("dddd, MMMM d, yyyy"))
                </h1>
            </div>

            <div class="col-auto text-end">
                <NavButtons Date="Date" />
            </div>
        </div>

        @if (Error is not null)
        {
            <div class="alert alert-danger py-2 mb-0" role="alert">
                <i class="bi bi-exclamation-triangle-fill"></i>
                @Error
            </div>
        }

        <div class="vstack gap-2">
            <div class="row g-2 align-items-end border-bottom pb-2">
                <div class="col-1">
                    Time
                </div>
                <div class="col-1">
                    Hours
                </div>
                <div class="col-2">
                    Project

                    <a href="/projects" class="ms-1 small">
                        Manage
                    </a>
                </div>
                <div class="col-1">
                    Task ID
                </div>
                <div class="col">
                    Description
                </div>
                <div class="col-1">
                    Sort
                </div>
                <div class="col-auto">
                    <button type="button"
                            class="btn btn-sm btn-outline-secondary"
                            title="Copy the previous day's entries"
                            @onclick="CopyEntriesAsync"
                            disabled="@(!CanCopy)">
                        <i class="bi bi-copy"></i>
                    </button>
                </div>
            </div>

            @foreach (var entry in OrderedEntries)
            {
                <EntryRow @key="entry.Id" Entry="entry" Projects="Projects" OnEntryChanged="ReloadDayAsync" />
            }

            @if (Entries.Count == 0)
            {
                <div class="text-center text-muted small py-3">
                    No entries for this day.
                </div>
            }

            <div class="row">
                @if (Entries.Count > 0)
                {
                    <div class="col-2 text-end">
                        <div>
                            Total:
                            <strong class="@(TotalHours >= 8 ? "text-success" : "")">
                                @TotalHours.ToString("N2")
                            </strong>
                        </div>
                        <div>
                            Week:
                            <strong class="@(WeekTotalHours >= 40 ? "text-success" : "")">
                                @WeekTotalHours.ToString("N2")
                            </strong>
                        </div>
                    </div>

                    @if (HasInvalidTimes)
                    {
                        <div class="col text-danger small">
                            <i class="bi bi-exclamation-triangle"></i>
                            Some times could not be read and are not counted.
                        </div>
                    }
                }

                <div class="col text-end">
                    <button type="button" class="btn btn-primary btn-sm" @onclick="AddEntryAsync">
                        Add Entry
                    </button>
                </div>
            </div>
        </div>
    </div>
}
